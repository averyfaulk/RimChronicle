# OPENCODE_API_KEY: Required for OpenCode Zen / OpenCode Go AI calls.
# Get your key at https://opencode.ai/auth
OPENCODE_API_KEY=""

# OPENCODE_PROVIDER: Startup default gateway. You can also switch provider
# and model live from the picker in the app header (persisted in your browser).
#   "zen" = pay-per-use Zen gateway (https://opencode.ai/zen/v1)
#   "go"  = OpenCode Go subscription tier (https://opencode.ai/zen/go/v1)
OPENCODE_PROVIDER="zen"

# OPENCODE_MODEL: Startup default model ID. Browse the full catalog at
# https://opencode.ai/zen/v1/models or pick one in the app's header dropdown.
# Defaults to "big-pickle" on zen, "deepseek-v4-flash" on go if unset.
OPENCODE_MODEL="big-pickle"
